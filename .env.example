# Copy to .env.production on the server. Do not commit .env.production.
# Values below are examples only; replace them for the deployment.

# Required server-only values
DATABASE_URL=postgresql://SECOND_DB_USER:SECOND_DB_PASSWORD@127.0.0.1:5432/second
APP_ORIGIN=https://YOUR_DOMAIN
VENUE_ROOT_DOMAIN=YOUR_DOMAIN
VENUE_MEETING_AREAS='[{"id":"main-bar-a","label":"Main Bar A","labelZh":"主吧台 A 区"}]'

# Required public build setting. The production app has no demo fallback.
NEXT_PUBLIC_MATCH_MODE=realtime

# Optional server-only database TLS controls. Keep verification enabled unless the database provider explicitly requires otherwise.
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Optional server-only overrides.
# REALTIME_PORT=3002
# REALTIME_HOST=127.0.0.1
# COCKTAIL_GENERATION_MODE=local
# OPENAI_API_KEY=
